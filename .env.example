# Optional: copy to .env to override the defaults used by docker-compose.yml.

POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=store_front_sync

# Host ports
API_PORT=3000
PLATFORM_MOCK_PORT=4000
DB_PORT=5432

# Browser-facing base URLs (listing URLs, Swagger "Try it out"). Default to localhost + the ports above.
# API_PUBLIC_URL=http://localhost:3000
# PLATFORM_PUBLIC_URL=http://localhost:4000

# platform-mock chaos defaults (can also be changed at runtime via /admin/chaos)
CHAOS_LATENCY_MS=0
CHAOS_ERROR_RATE=0
CHAOS_MALFORMED_RATE=0

# worker: a check round starts every N seconds; each platform request times out after REQUEST_TIMEOUT_MS
CHECK_INTERVAL_SECONDS=60
REQUEST_TIMEOUT_MS=5000
