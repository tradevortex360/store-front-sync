                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('status is 200', () => pm.response.to.have.status(200));",
                      "pm.test('status is a known value', () => pm.expect(pm.response.json().status).to.be.oneOf(['OPEN', 'CLOSED', 'PAUSED']));"
                    ]
