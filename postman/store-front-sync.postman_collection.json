            {
              "name": "Get listing status",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{mockBaseUrl}}/listings/:id/status",
                  "host": [
                    "{{mockBaseUrl}}"
                  ],
                  "path": [
                    "listings",
                    ":id",
                    "status"
                  ],
                  "variable": [
                    {
                      "key": "id",
                      "value": "{{listingId}}"
                    }
