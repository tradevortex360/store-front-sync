{
  "info": {
    "name": "store-front-sync",
    "description": "Every HTTP endpoint of store-front-sync. Keep in sync with the code: test/postman-collection.spec.ts fails when a route is missing here.\n\nRun all: `pnpm test:postman` (stack must be up via `docker compose up`).\nRequests run top to bottom; admin requests change mock state and the folder ends with a reset.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "apiBaseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "mockBaseUrl",
      "value": "http://localhost:4000"
    },
    {
      "key": "listingId",
      "value": "lst_ber_001"
    }
  ],
  "item": [
    {
      "name": "api",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{apiBaseUrl}}/health",
              "host": [
                "{{apiBaseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "200 when the API is up and the database answers, 503 otherwise."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('database is up', () => pm.expect(pm.response.json().info.database.status).to.eql('up'));"
                ]
              }
            }
          ]
        },
        {
          "name": "List mismatches",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{apiBaseUrl}}/mismatches",
              "host": [
                "{{apiBaseUrl}}"
              ],
              "path": [
                "mismatches"
              ]
            },
            "description": "Stored mismatches (comparisons whose result is not `match`), newest first, 100 per page by default."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('has total, limit, offset and items', () => { pm.expect(body.total).to.be.a('number'); pm.expect(body.limit).to.be.a('number'); pm.expect(body.offset).to.be.a('number'); pm.expect(body.items).to.be.an('array'); });",
                  "pm.test('items are mismatches with both times', () => body.items.forEach((m) => { pm.expect(['open_outside_hours', 'closed_during_hours', 'paused_during_hours']).to.include(m.kind); pm.expect(['OPEN', 'CLOSED', 'PAUSED']).to.include(m.actualStatus); pm.expect(m.expectedOpen).to.be.a('boolean'); pm.expect(Date.parse(m.comparedAt)).to.be.at.least(Date.parse(m.checkedAt)); }));",
                  "pm.test('newest first', () => body.items.forEach((m, i) => i && pm.expect(Date.parse(m.comparedAt)).to.be.at.most(Date.parse(body.items[i - 1].comparedAt))));",
                  "pm.test('default page', () => { pm.expect(body.limit).to.eql(100); pm.expect(body.offset).to.eql(0); });"
                ]
              }
            }
          ]
        },
        {
          "name": "List mismatches (filtered)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{apiBaseUrl}}/mismatches?listingId={{listingId}}&from=2026-01-01T00:00:00Z&limit=5",
              "host": [
                "{{apiBaseUrl}}"
              ],
              "path": [
                "mismatches"
              ],
              "query": [
                {
                  "key": "listingId",
                  "value": "{{listingId}}"
                },
                {
                  "key": "from",
                  "value": "2026-01-01T00:00:00Z"
                },
                {
                  "key": "limit",
                  "value": "5"
                }
              ]
            },
            "description": "Mismatches of one listing since a given time, 5 per page."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('has total, limit, offset and items', () => { pm.expect(body.total).to.be.a('number'); pm.expect(body.limit).to.be.a('number'); pm.expect(body.offset).to.be.a('number'); pm.expect(body.items).to.be.an('array'); });",
                  "pm.test('items are mismatches with both times', () => body.items.forEach((m) => { pm.expect(['open_outside_hours', 'closed_during_hours', 'paused_during_hours']).to.include(m.kind); pm.expect(['OPEN', 'CLOSED', 'PAUSED']).to.include(m.actualStatus); pm.expect(m.expectedOpen).to.be.a('boolean'); pm.expect(Date.parse(m.comparedAt)).to.be.at.least(Date.parse(m.checkedAt)); }));",
                  "pm.test('newest first', () => body.items.forEach((m, i) => i && pm.expect(Date.parse(m.comparedAt)).to.be.at.most(Date.parse(body.items[i - 1].comparedAt))));",
                  "pm.test('only the requested listing', () => body.items.forEach((m) => pm.expect(m.listingId).to.eql(pm.collectionVariables.get('listingId'))));",
                  "pm.test('limit is applied', () => { pm.expect(body.limit).to.eql(5); pm.expect(body.items.length).to.be.at.most(5); });"
                ]
              }
            }
          ]
        },
        {
          "name": "List mismatches (invalid kind → 400)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{apiBaseUrl}}/mismatches?kind=bogus",
              "host": [
                "{{apiBaseUrl}}"
              ],
              "path": [
                "mismatches"
              ],
              "query": [
                {
                  "key": "kind",
                  "value": "bogus"
                }
              ]
            },
            "description": "An unknown `kind` (or any other invalid parameter) is rejected with 400."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 400', () => pm.response.to.have.status(400));",
                  "pm.test('error body', () => pm.expect(pm.response.json().statusCode).to.eql(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "OpenAPI document",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{apiBaseUrl}}/docs-json",
              "host": [
                "{{apiBaseUrl}}"
              ],
              "path": [
                "docs-json"
              ]
            },
            "description": "Raw OpenAPI 3 document behind the Swagger UI at /docs."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const doc = pm.response.json();",
                  "pm.test('is an OpenAPI 3 document', () => pm.expect(doc.openapi).to.match(/^3[.]/));",
                  "pm.test('has the right title', () => pm.expect(doc.info.title).to.eql('store-front-sync api'));",
                  "pm.test('every operation has a summary', () => Object.values(doc.paths).forEach((item) => Object.values(item).forEach((op) => pm.expect(op.summary).to.be.a('string'))));"
                ]
              }
            }
          ]
        }
      ]
    },
