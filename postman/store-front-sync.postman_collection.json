                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('status is 200', () => pm.response.to.have.status(200));",
                      "const body = pm.response.json();",
                      "pm.test('returns 5 listings', () => pm.expect(body).to.be.an('array').with.lengthOf(5));",
                      "pm.test('listings match the contract', () => body.forEach((l) => {",
                      "  pm.expect(l).to.have.all.keys('id', 'name', 'timezone', 'listingUrl', 'openingHours');",
                      "  pm.expect(l.openingHours).to.have.all.keys('mon', 'tue', 'wed', 'thu', 'fri', 'sat', 'sun');",
                      "}));"
                    ]
                  }
                }
              ]
